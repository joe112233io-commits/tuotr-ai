// TutorAI.me clone — rebuilt from reverse-engineering evidence (see scratch/message-attachments/tutorai-me-reverse-engineering/README.md)
// Stack on Perchance: ai-text-plugin (course generation) + kv-plugin (persistence) instead of Firebase/Stripe.
// Firebase/Stripe from the original are NOT reused here — auth & billing are local demo equivalents.

$meta
  title = TutorAI — Next Level AI Tutoring for Life-Long Learners
  description = Create custom AI-generated courses on anything. Personalized learning paths, lessons, quizzes & flashcards.
  header
    mode = minimal

generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}
superFetch = {import:super-fetch-plugin}

// ---- Suggested / popular topics (from app-page.js + create-course page) ----
suggestedTopics
  Productivity Mastery
  Creative Writing
  Public Speaking
  Financial Literacy
  Startup Fundamentals
  Growth Hacking
  Sustainable Living

popularCourses
  Fundamentals of Machine Learning|fundamentals-of-machine-learning-for-beginners
  Intermediate French|french-grammar-as-a-second-language-intermediate-level
  Mindfulness at work|mindfulness-and-stress-management-for-professionals

// ---- Feature cards (homepage, from app-page.js) ----
homeFeatures
  🎯|Personalized Learning Paths|Get custom courses tailored to your goals, learning style, and current knowledge level.
  ⚡|Instant Course Creation|Generate comprehensive courses on any topic in seconds with AI-powered content.
  📚|Comprehensive Content|Access detailed lessons, quizzes, flashcards, and study materials all in one place.
  🤖|AI Homework Helper|Upload any homework question and get step-by-step solutions with clear explanations.
  📊|Track Your Progress|Monitor your learning journey with detailed analytics and progress tracking.
  🌐|Learn Anything|From academics to professional skills, languages to hobbies — no limits on topics.

// ---- How it works ----
howItWorks
  01|💡|Choose Your Topic|Tell us what you want to learn — any subject, any level, any goal.
  02|🤖|AI Creates Your Course|Our AI generates a personalized course with lessons, quizzes, and study materials.
  03|📖|Learn at Your Pace|Study whenever, wherever. Progress through content designed just for you.
  04|🎉|Master Your Subject|Complete your course, pass quizzes, and achieve your learning goals.

// ---- Audiences ----
audiences
  🎓|Students & Academics|Excel in your studies with personalized courses, homework help, and exam preparation tools.
  💼|Professionals & Career Growth|Upskill for your career with custom training on new technologies, business skills, and more.
  🌱|Lifelong Learners|Explore new interests, learn languages, develop hobbies — learning never stops.
  🏢|Businesses & Teams|Train your team efficiently with customized corporate learning and onboarding programs.

// ---- FAQ ----
faq
  How does Tutor AI create personalized courses?|Our AI analyzes your learning goals, current knowledge level, and preferred learning style to generate custom courses with relevant content, quizzes, and study materials tailored just for you.
  What subjects can I learn with Tutor AI?|You can learn virtually anything! From academic subjects like math, science, and languages, to professional skills, hobbies, and personal development. If you can think of it, we can create a course for it.
  Can Tutor AI help with my homework?|Yes! Upload any homework question or problem, and our AI will provide step-by-step solutions with detailed explanations to help you understand the concepts.
  Is Tutor AI free to use?|We offer both free and premium plans. The free plan includes access to course creation and basic features. Premium plans unlock additional features like unlimited courses, advanced analytics, and priority support.
  How long does it take to create a course?|Our AI generates comprehensive courses in just seconds! You can start learning immediately after creating your course.
  Can I use Tutor AI for business training?|Absolutely! We offer enterprise solutions for corporate training, employee onboarding, and team development. Contact us to learn more about our business plans.

// ---- Simple client-side banned-word guard (server did the real check; we mirror the UX message) ----
bannedWords
  hack-bank
  bomb-making
  cheat-exam-answers

// ---- Pricing (from pricing RSC payload, group B shown by default) ----
getPricingData(lang) =>
  if (lang === "ar") return [{id:0,name:"البداية",tag:"لا حاجة لبطاقة",monthly:0,yearly:0,perMonthBilledYearly:0,maxCourses:6,maxLessons:3,features:["تعرف على طريقة العمل","لا حاجة للدفع","دعم محدود"]},{id:1,name:"المرشد",tag:"الأكثر شعبية",monthly:16,yearly:160,perMonthBilledYearly:13.33,maxCourses:100,maxLessons:250,features:["أكثر من 100 دورة مخصصة عند الطلب","محادثات غير محدودة","دعم ذو أولوية","إلغاء في أي وقت دون أسئلة"]},{id:2,name:"العبقري",tag:"للمتعلمين المكثفين",monthly:21,yearly:210,perMonthBilledYearly:17.5,maxCourses:1000,maxLessons:1500,features:["أكثر من 1000 دورة مخصصة","بطاقات تعليمية ولوحة المراجعة المتباعدة","دعم ذو أولوية","إلغاء في أي وقت دون أسئلة"]}];
  return [{id:0,name:"Starter",tag:"No card required",monthly:0,yearly:0,perMonthBilledYearly:0,maxCourses:6,maxLessons:3,features:["Get a feel for how it works","No payment required","Limited support"]},{id:1,name:"Mentor",tag:"Most popular",monthly:16,yearly:160,perMonthBilledYearly:13.33,maxCourses:100,maxLessons:250,features:["100+ personalized, on-demand courses","Unlimited chat interactions","Priority support","Cancel anytime, no questions asked"]},{id:2,name:"Genius",tag:"For power learners",monthly:21,yearly:210,perMonthBilledYearly:17.5,maxCourses:1000,maxLessons:1500,features:["1000+ personalized, on-demand courses","Flashcards and spaced repetition dashboard","Priority support","Cancel anytime, no questions asked"]}];

planName(id, lang) =>
  if (lang === "ar") { if (id === 2) return "العبقري"; if (id === 1) return "المرشد"; return "مجانية"; }
  if (id === 2) return "Genius";
  if (id === 1) return "Mentor";
  return "Free";

slugify(s) =>
  return String(s || "").toLowerCase().trim().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 80) || "course";

// ---- Arabic content mirrors (picked when UI language is ar) ----
suggestedTopicsAr
  إتقان الإنتاجية
  الكتابة الإبداعية
  الخطابة والإلقاء
  الثقافة المالية
  أساسيات الشركات الناشئة
  استراتيجيات النمو
  العيش المستدام

popularCoursesAr
  أساسيات تعلم الآلة|fundamentals-of-machine-learning-for-beginners
  الفرنسية المتوسطة|french-grammar-as-a-second-language-intermediate-level
  اليقظة الذهنية في العمل|mindfulness-and-stress-management-for-professionals

homeFeaturesAr
  🎯|مسارات تعلم مخصصة|دورات مصممة حسب أهدافك وأسلوب تعلمك ومستواك الحالي.
  ⚡|إنشاء فوري للدورات|ولّد دورات شاملة عن أي موضوع في ثوان بقوة الذكاء الاصطناعي.
  📚|محتوى شامل|دروس واختبارات وبطاقات تعليمية ومواد دراسية في مكان واحد.
  🤖|مساعد الواجبات الذكي|ارفع أي سؤال وستحصل على حل خطوة بخطوة مع شرح واضح.
  📊|تتبع تقدمك|راقب رحلة تعلمك بإحصائيات تفصيلية وتتبع للتقدم.
  🌐|تعلم أي شيء|من الدراسة الأكاديمية إلى المهارات المهنية واللغات والهوايات بلا حدود.

howItWorksAr
  01|💡|اختر موضوعك|أخبرنا ماذا تريد أن تتعلم، أي مادة وأي مستوى وأي هدف.
  02|🤖|الذكاء الاصطناعي يبني دورتك|يولد ذكاؤنا الاصطناعي دورة مخصصة بدروس واختبارات ومواد دراسية.
  03|📖|تعلم بإيقاعك|ادرس متى تشاء وأينما تشاء عبر محتوى مصمم لك.
  04|🎉|أتقن مادتك|أكمل دورتك واجتز الاختبارات وحقق أهدافك التعليمية.

audiencesAr
  🎓|الطلاب والأكاديميون|تفوق في دراستك بدورات مخصصة ومساعدة في الواجبات وأدوات التحضير للامتحانات.
  💼|المهنيون والتطور الوظيفي|طور مهاراتك المهنية بتدريب مخصص على التقنيات الحديثة ومهارات الأعمال وغيرها.
  🌱|المتعلمون مدى الحياة|اكتشف اهتمامات جديدة وتعلم اللغات وطور الهوايات، فالتعلم لا يتوقف.
  🏢|الشركات والفرق|درب فريقك بكفاءة عبر برامج تعلم مخصصة للشركات وتهيئة الموظفين.

faqAr
  كيف ينشئ Tutor AI دورات مخصصة؟|يحلل ذكاؤنا الاصطناعي أهدافك التعليمية ومستواك الحالي وأسلوب تعلمك المفضل ليولد دورات مخصصة بمحتوى مناسب واختبارات ومواد دراسية مصممة لك.
  ما المواد التي يمكنني تعلمها مع Tutor AI؟|يمكنك تعلم أي شيء تقريبا! من المواد الأكاديمية كالرياضيات والعلوم واللغات إلى المهارات المهنية والهوايات والتطوير الشخصي. إن خطر ببالك موضوع، يمكننا إنشاء دورة عنه.
  هل يساعدني Tutor AI في واجباتي؟|نعم! ارفع أي سؤال أو مسألة وسيقدم لك الذكاء الاصطناعي حلولا خطوة بخطوة مع شروحات مفصلة تساعدك على فهم المفاهيم.
  هل استخدام Tutor AI مجاني؟|نوفر خططا مجانية ومدفوعة. الخطة المجانية تشمل إنشاء الدورات والمزايا الأساسية، بينما تفتح الخطط المدفوعة مزايا إضافية كالدورات غير المحدودة والتحليلات المتقدمة والدعم ذي الأولوية.
  كم يستغرق إنشاء الدورة؟|يولد ذكاؤنا الاصطناعي دورات شاملة في ثوان معدودة! يمكنك بدء التعلم فور إنشاء دورتك.
  هل يمكنني استخدام Tutor AI لتدريب الشركات؟|بالتأكيد! نوفر حلولا للشركات للتدريب وتهيئة الموظفين وتطوير الفرق. تواصل معنا لمعرفة المزيد عن خطط الأعمال.
